kernel:
  landlock: ABI 2
    network policy is NOT enforced (needs ABI 4, Linux 6.7)
    abstract sockets and signals are NOT scoped (needs ABI 6, Linux 6.12)
  user namespaces: yes
  nested namespaces: refused (kernel limit, seccomp)
  private network: available
    runs that allow egress use the private network namespace by default
  cgroup delegation: memory, pids, cpu
audit:
  kernel BTF: yes
